# syntax=docker/dockerfile:1
FROM --platform=$TARGETPLATFORM golang:1.25 AS builder
ARG VERSION
ARG TARGETARCH

# Install PAM development headers required by the cgo build.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpam0g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Download Go modules (cached layer)
# third_party is copied before go mod download because go.mod replaces
# github.com/modelcontextprotocol/go-sdk with a local (patched) copy.
COPY go.mod go.sum ./
COPY third_party/ third_party/
RUN go mod download

# Build
COPY . .
RUN CGO_ENABLED=1 GOOS=linux GOARCH=${TARGETARCH} go build \
    -buildvcs=false \
    -ldflags "-s -w -X main.Version=${VERSION}" \
    -o podmanview ./cmd/podmanview

RUN tar -czvf /podmanview-linux-${TARGETARCH}.tar.gz podmanview web/

# Export only the artifact
FROM scratch AS export
COPY --from=builder /podmanview-linux-*.tar.gz /
